{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-pro",
  "small_model": "opencode/north-mini-code-free",
  "default_agent": "orchestrator",
  "share": "disabled",
  "autoupdate": "notify",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets/**": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "rg*": "allow",
      "bat*": "allow",
      "eza*": "allow",
      "fd*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "dotnet test*": "allow",
      "go test*": "allow",
      "cargo test*": "allow",
      "python -m pytest*": "allow",
      "./ai/scripts/verify.sh*": "allow",
      "./ai/scripts/audit-readonly.sh*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "git commit*": "ask"
    },
    "webfetch": "allow",
    "websearch": "ask"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "bin/**",
      "obj/**",
      "coverage/**",
      ".git/**",
      "ai/state/**"
    ]
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "/home/federico/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "brave-cdp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://localhost:9222"
      ],
      "enabled": false
    }
  }
}
