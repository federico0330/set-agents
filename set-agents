#!/usr/bin/env bash
# Unified console app for the harness: install, update, models, tools, MCPs.
# Portable symlink resolution (no `readlink -f`: absent on macOS/BSD).
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
exec python3 "$ROOT/ai/scripts/set_agents_app.py" "$@"
